# Load libraries
library(readxl)
library(dplyr)
library(tidyr)
library(ggplot2)

# -------------------------
# LOAD DATA
# -------------------------
df <- read_excel("data/raw/EDS_Monthly_energy_generation.xlsx")

# -------------------------
# CLEANING & AGGREGATION
# -------------------------
names(df) <- trimws(names(df))  # Clean column names

yearly <- df %>%
  group_by(YEAR, `ENERGY SOURCE`) %>%
  summarise(GENERATION = sum(`GENERATION (Megawatthours)`), .groups = 'drop')

pivot <- yearly %>%
  pivot_wider(names_from = `ENERGY SOURCE`, values_from = GENERATION, values_fill = 0)

# -------------------------
# DEFINE ENERGY GROUPS
# -------------------------
renewables <- c("Wind", "Solar Thermal and Photovoltaic", "Hydroelectric Conventional",
                "Geothermal", "Biomass")
fossil <- c("Coal", "Petroleum", "Natural Gas")

pivot <- pivot %>%
  mutate(
    Renewable_Total = rowSums(across(all_of(renewables))),
    Fossil_Total = rowSums(across(all_of(fossil))),
    Total_Generation = Renewable_Total + Fossil_Total,
    Renewable_Share = Renewable_Total / Total_Generation
  )

# -------------------------
# CREATE FIGURES
# -------------------------
# Ensure figures folder exists
if(!dir.exists("outputs/figures")) dir.create("outputs/figures", recursive = TRUE)

# Figure 1: Renewable Growth
ggplot(pivot, aes(x = YEAR, y = Renewable_Total)) +
  geom_line(color = "forestgreen", size = 1) +
  labs(title = "Renewable Electricity Generation (U.S.)",
       x = "Year", y = "Megawatt-hours") +
  theme_minimal()
ggsave("outputs/figures/fig1_renewable_growth.png", width = 8, height = 5)

# Figure 2: Fossil Generation
ggplot(pivot, aes(x = YEAR, y = Fossil_Total)) +
  geom_line(color = "firebrick", size = 1) +
  labs(title = "Fossil Fuel Electricity Generation (Emissions Proxy)",
       x = "Year", y = "Megawatt-hours") +
  theme_minimal()
ggsave("outputs/figures/fig2_fossil_trend.png", width = 8, height = 5)

# Figure 3: Renewable Share vs Fossil Generation
ggplot(pivot, aes(x = Renewable_Share, y = Fossil_Total)) +
  geom_point() +
  geom_smooth(method = "lm", se = TRUE, color = "blue") +
  labs(title = "Renewable Share vs Fossil Generation",
       x = "Renewable Share", y = "Fossil Generation") +
  theme_minimal()
ggsave("outputs/figures/fig3_relationship.png", width = 8, height = 5)

# Optional: Key findings summary
summary_text <- paste0(
  "Key Findings:\n",
  "- Renewable generation is steadily increasing.\n",
  "- Fossil generation shows a plateauing or declining trend.\n",
  "- Renewable share growth correlates with fossil generation decrease.\n"
)
writeLines(summary_text, "outputs/key_findings.md")

print("All figures and key findings created successfully."
